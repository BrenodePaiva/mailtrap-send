# Porta em que o servidor escuta
PORT=3000

# Ambiente de execução: development | production | test
NODE_ENV=development

# Origem permitida pelo CORS (ex.: http://localhost:8080 para testes no front)
CORS_ORIGIN=http://localhost:8080

# Mailtrap (https://mailtrap.io/api-tokens)
MAILTRAP_API_TOKEN=
MAILTRAP_SENDER_EMAIL=
MAILTRAP_SENDER_CONTACT=contact Mailtrap
MAILTRAP_SENDER_CURRICULUM=curriculum Mailtrap
MAILTRAP_BRAND_NAME=Meu Site

# Caminho do arquivo da logo (usado como imagem inline no e-mail).
# Se o arquivo não existir, o nome da marca (MAILTRAP_BRAND_NAME) é usado no header.
MAILTRAP_LOGO_PATH=src/assets/logo.png

# Tamanho máximo (em MB) do currículo em PDF enviado na rota de currículo
MAX_RESUME_SIZE_MB=3

# Destinatário fixo dos e-mails de contato
MAILTRAP_TO_CONTACT=

# Destinatário fixo dos e-mails de currículo
MAILTRAP_TO_CURRICULUM=